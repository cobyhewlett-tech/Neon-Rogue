rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default-deny all unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidDailyScore(data) {
      return data.keys().hasAll([
          'uid',
          'dateKey',
          'challengeCode',
          'pilotName',
          'shipId',
          'shipName',
          'mutatorName',
          'score',
          'kills',
          'survivalTime',
          'level',
          'bossesDefeated',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'dateKey',
          'challengeCode',
          'pilotName',
          'shipId',
          'shipName',
          'mutatorName',
          'score',
          'kills',
          'survivalTime',
          'level',
          'bossesDefeated',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.dateKey is string
        && data.dateKey.size() == 10
        && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.challengeCode is string
        && data.challengeCode.size() >= 3
        && data.challengeCode.size() <= 32
        && data.pilotName is string
        && data.pilotName.size() >= 1
        && data.pilotName.size() <= 32
        && data.shipId is string
        && isValidId(data.shipId)
        && data.shipId.size() <= 32
        && data.shipName is string
        && data.shipName.size() >= 1
        && data.shipName.size() <= 48
        && data.mutatorName is string
        && data.mutatorName.size() >= 1
        && data.mutatorName.size() <= 48
        && data.score is int
        && data.score >= 0
        && data.score <= 100000000
        && data.kills is int
        && data.kills >= 0
        && data.kills <= 1000000
        && data.survivalTime is int
        && data.survivalTime >= 0
        && data.survivalTime <= 86400
        && data.level is int
        && data.level >= 1
        && data.level <= 999
        && data.bossesDefeated is int
        && data.bossesDefeated >= 0
        && data.bossesDefeated <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /daily_scores/{entryId} {
      // Public leaderboard reads: strictly scoped to valid score documents (no PII stored)
      allow get: if isValidId(entryId)
        && resource.data.dateKey is string
        && resource.data.score is int;

      allow list: if resource.data.dateKey is string
        && resource.data.score is int
        && 'limit' in request.query
        && request.query.limit is int
        && request.query.limit > 0
        && request.query.limit <= 50;

      allow create: if isVerifiedUser()
        && isValidId(entryId)
        && isValidDailyScore(incoming())
        && entryId == (incoming().dateKey + '_' + request.auth.uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(entryId)
        && isValidDailyScore(incoming())
        && existing().uid == request.auth.uid
        && incoming().uid == existing().uid
        && incoming().dateKey == existing().dateKey
        && incoming().challengeCode == existing().challengeCode
        && incoming().mutatorName == existing().mutatorName
        && incoming().shipId == existing().shipId
        && incoming().shipName == existing().shipName
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().score > existing().score
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'pilotName',
          'score',
          'kills',
          'survivalTime',
          'level',
          'bossesDefeated',
          'updatedAt'
        ]);

      allow delete: if false;
    }
  }
}
